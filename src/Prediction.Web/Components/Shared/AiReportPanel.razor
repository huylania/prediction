@implements IDisposable
@using Markdig
@inject AiReportService Reports
@inject TimeDisplay Time

<div class="an-section ai-report">
    <h2>
        <span class="num">AI</span> Báo cáo Claude theo file kỹ năng
        @if (_report is { } r && !_running)
        {
            <span class="small text-muted fw-normal ms-auto">@r.Model · @Time.Short(r.CreatedAtUtc) · @r.WebSearches lượt tra web · ~$@r.CostUsd.ToString("0.00")</span>
        }
    </h2>

    @if (!Reports.IsConfigured)
    {
        <p class="small mb-1">Chưa cấu hình API key Claude. Lấy key ở <strong>console.anthropic.com</strong> rồi chạy trong thư mục <code>src/Prediction.Web</code>:</p>
        <pre class="small bg-light p-2 mb-1">dotnet user-secrets set "Anthropic:ApiKey" "sk-ant-..."</pre>
        <p class="hint mb-0">Khởi động lại website sau khi đặt key. Mỗi báo cáo tốn khoảng $0.4–1.0 (model @Reports.Model, có tra cứu web); lần sau trong 1 giờ rẻ hơn nhờ cache.</p>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
            @if (_running)
            {
                <span class="spinner-border spinner-border-sm text-success"></span>
                <span class="small">@(_status ?? "Claude đang phân tích…")</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="Cancel">Dừng</button>
            }
            else
            {
                <button class="btn btn-sm btn-success" @onclick="GenerateAsync">@(_report is null ? "Viết báo cáo AI" : "Phân tích lại")</button>
                <span class="hint">Claude đọc toàn bộ số liệu phân tích ở trên, tự tra cứu web (tân binh, HLV, đội hình, chấn thương) và viết theo mục 9 của file kỹ năng. Ước tính $0.4–1.0/lượt.</span>
            }
        </div>
        @if (!_running && Fixture is { } fx && (fx.IsLive || fx.IsFinished))
        {
            <div class="alert alert-warning py-1 px-2 small mb-2">
                @if (fx.IsLive)
                {
                    <span>Trận đang đá (@FixtureStatus.Label(fx.Status)@(fx.Elapsed is { } el ? $", phút {el}" : ""), @fx.HomeGoals-@fx.AwayGoals): kèo trước trận đã đóng. Báo cáo sẽ kèm số liệu live (sút, góc, xG, thẻ, kèo live) và tập trung vào kịch bản In-play.</span>
                }
                else
                {
                    <span>Trận đã kết thúc (@fx.HomeGoals-@fx.AwayGoals): báo cáo chỉ để đối chiếu, rút kinh nghiệm — vẫn tốn tiền như bình thường.</span>
                }
            </div>
        }
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small">@_error</div>
        }
        @if (!_running && _history.Count > 1)
        {
            <details class="small mb-2" open="@(_viewing is not null)">
                <summary>Các bản đã viết (@_history.Count)</summary>
                <ul class="list-unstyled mb-0 ms-2">
                    @foreach (var h in _history)
                    {
                        var current = _report?.Id == h.Id;
                        <li>
                            @if (current)
                            {
                                <strong>@Time.Short(h.CreatedAtUtc)</strong>
                            }
                            else
                            {
                                <button class="btn btn-link btn-sm p-0" @onclick="() => ShowAsync(h.Id)">@Time.Short(h.CreatedAtUtc)</button>
                            }
                            <span class="text-muted">· @h.Model · @h.WebSearches lượt web · ~$@h.CostUsd.ToString("0.00")</span>
                            @if (!h.Complete) { <span class="badge bg-warning text-dark">dở dang</span> }
                            @if (current) { <span class="text-muted">(đang xem)</span> }
                        </li>
                    }
                </ul>
            </details>
        }
        @if (!_running && _viewing is not null)
        {
            <div class="alert alert-secondary py-1 px-2 small mb-2">
                Đang xem bản lúc @Time.Short(_viewing.CreatedAtUtc)@(_viewing.Complete ? "" : " (dở dang)"), không phải bản mới nhất.
                <button class="btn btn-link btn-sm p-0 align-baseline" @onclick="ShowLatestAsync">Về bản mới nhất</button>
            </div>
        }
        @if (_running ? _buffer.Length > 0 : _report is not null)
        {
            <div class="ai-markdown">@((MarkupString)Markdown.ToHtml(_running ? _buffer.ToString() : _report!.Markdown, Pipeline))</div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public int FixtureId { get; set; }

    /// <summary>Trận (để cảnh báo khi bấm báo cáo lúc đang đá / đã xong).</summary>
    [Parameter] public Fixture? Fixture { get; set; }

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder().UseAdvancedExtensions().DisableHtml().Build();

    private AiReport? _report;
    private AiReport? _viewing;
    private List<AiReportSummary> _history = [];
    private bool _running;
    private string? _status;
    private string? _error;
    private readonly System.Text.StringBuilder _buffer = new();
    private CancellationTokenSource? _cts;
    private DateTime _lastRender;

    protected override async Task OnParametersSetAsync()
    {
        if (Reports.IsConfigured)
        {
            await ShowLatestAsync();
        }
    }

    private async Task ShowLatestAsync()
    {
        _viewing = null;
        _report = await Reports.LatestAsync(FixtureId);
        _history = await Reports.HistoryAsync(FixtureId);
    }

    private async Task ShowAsync(long id)
    {
        var report = await Reports.GetAsync(id);
        if (report is null)
        {
            return;
        }

        var latest = await Reports.LatestAsync(FixtureId);
        _report = report;
        _viewing = latest?.Id == id ? null : report;
    }

    private async Task GenerateAsync()
    {
        _cts = new CancellationTokenSource();
        _running = true;
        _error = null;
        _status = null;
        _buffer.Clear();
        try
        {
            _report = await Reports.GenerateAsync(FixtureId, OnUpdateAsync, _cts.Token);
            _viewing = null;
        }
        catch (OperationCanceledException)
        {
            _error = _buffer.Length > 0 ? "Đã dừng. Phần đã nhận được lưu thành bản dở dang (xem ở \"Các bản đã viết\")." : "Đã dừng.";
        }
        catch (Exception ex)
        {
            _error = $"Lỗi khi gọi Claude: {ex.Message}" + (_buffer.Length > 0 ? " Phần đã nhận được lưu thành bản dở dang." : "");
        }
        finally
        {
            _running = false;
            _cts?.Dispose();
            _cts = null;
        }

        _history = await Reports.HistoryAsync(FixtureId);
        _report ??= await Reports.LatestAsync(FixtureId); // lần đầu viết mà lỗi giữa chừng: hiện bản dở dang vừa lưu
    }

    private async Task OnUpdateAsync(AiReportUpdate update)
    {
        if (update.Text is { } text)
        {
            _buffer.Append(text);
            _status = "Claude đang viết…";
        }

        if (update.Status is { } status)
        {
            _status = status;
        }

        // Vẽ lại tối đa ~4 lần/giây để không nghẽn kết nối.
        if (update.Status is not null || DateTime.UtcNow - _lastRender > TimeSpan.FromMilliseconds(250))
        {
            _lastRender = DateTime.UtcNow;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void Cancel() => _cts?.Cancel();

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }
}
