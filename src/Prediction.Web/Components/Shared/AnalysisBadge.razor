<span class="grp grp-@AnalysisGroupText.Short(Group)" title="@AnalysisGroupText.Label(Group)">
    @AnalysisGroupText.Short(Group)
    @if (Score is { } s)
    {
        <span>@s.ToString("0.0")</span>
    }
    @if (Flags is { Count: > 0 } flags)
    {
        <span class="grp-flag" title="@RedFlagText.Describe(flags)">cờ đỏ @string.Join(",", flags.Distinct().Order())</span>
    }
</span>

@code {
    [Parameter] public AnalysisGroup Group { get; set; }

    [Parameter] public double? Score { get; set; }

    /// <summary>Số hiệu cờ đỏ đang dính (nếu có).</summary>
    [Parameter] public IReadOnlyCollection<int>? Flags { get; set; }
}
