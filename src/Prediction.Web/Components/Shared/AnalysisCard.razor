@inject TimeDisplay Time
@{
    var a = R.Analysis;
    var best = a.Best;
    var f = R.Fixture;
}
<div class="an-card">
    <div class="top">
        <span class="fw-bold text-dark">@Time.Weekday(f.KickoffUtc) @Time.ToLocal(f.KickoffUtc).ToString("dd/MM HH:mm")</span>
        <span class="mc-league">@R.League?.Name</span>
        <a class="details" href="tran-dau/@f.Id?tab=phan-tich">Chi tiết →</a>
    </div>
    <div class="teams">
        @R.Home @if (R.Input.HomeStanding?.Rank is { } hr) { <span class="rank-pill">#@hr</span> }
        <span class="text-muted fw-normal mx-1">vs</span>
        @R.Away @if (R.Input.AwayStanding?.Rank is { } ar) { <span class="rank-pill">#@ar</span> }
    </div>
    @if (best is null)
    {
        <div class="meta">Chưa có kèo để chấm điểm.</div>
    }
    else
    {
        <div class="pick">
            <span>@(best.Group == AnalysisGroup.C ? "Đứng ngoài · bị loại: " : "")@best.Label <span class="text-muted fw-normal">@@@LineText.Odds(best.Odds)</span></span>
            <AnalysisBadge Group="best.Group" Score="best.Score" Flags="best.Flags" />
            @if (best.LowSample)
            {
                <span class="low-data" title="Một đội có dưới @MatchAnalyzer.MinSample trận trong dữ liệu: số liệu kém tin cậy, tối đa nhóm B">ít dữ liệu (@best.Sample trận)</span>
            }
        </div>
        <div class="meta">Thắng @Pct(best.Probability.WinAny) · thua @Pct(best.Probability.LossAny) · EV @Signed(best.ExpectedValue)</div>
        <OddsAlertChips Alerts="R.OddsAlerts" />
        @if (a.Flags.Count > 0)
        {
            <div class="mt-1">
                @foreach (var g in a.Flags.GroupBy(x => (x.Number, x.Title)))
                {
                    <span class="flag-pill" title="@g.First().Detail">Cờ @g.Key.Number: @g.Key.Title@Blocks(g, best)</span>
                }
            </div>
        }
        <ul>
            @foreach (var reason in best.Reasons.Skip(1).Take(2))
            {
                <li>@reason</li>
            }
        </ul>
        @* Chỉ kèm kèo cùng nhóm với kèo chính (thẻ A không kèm kèo B); kèo khác xem ở trang chi tiết. *@
        @foreach (var other in a.Picks.Skip(1).Where(p => p.Group == best.Group && p.Group != AnalysisGroup.C).Take(2))
        {
            <div class="meta mt-1">Kèo khác cùng nhóm: @other.Label @@@LineText.Odds(other.Odds) <AnalysisBadge Group="other.Group" Score="other.Score" /></div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public MatchAnalysisResult R { get; set; } = default!;

    private static string Pct(double v) => (v * 100).ToString("0", System.Globalization.CultureInfo.InvariantCulture) + "%";

    /// <summary>" · chặn chấp châu Á" khi cờ không áp lên kèo đang hiện, để khỏi tưởng cờ chặn kèo này.</summary>
    private static string Blocks(IEnumerable<RedFlag> flags, AnalysisPickResult best)
    {
        var list = flags.ToList();
        if (list.Any(x => x.Covers(best.Market, best.Side)))
        {
            return "";
        }

        var markets = list.SelectMany(x => x.Applies)
            .Select(x => Lower(AnalysisView.MarketName(x.Market)) + (x.Market == best.Market && x.Side is not null ? " cửa kia" : ""))
            .Distinct()
            .ToList();
        return markets.Count == 0 ? "" : " · chặn " + string.Join(", ", markets);
    }

    private static string Lower(string s) => s.Length == 0 ? s : char.ToLowerInvariant(s[0]) + s[1..];

    private static string Signed(double v) => (v >= 0 ? "+" : "−") + Math.Abs(v).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}
